---
import { getCollection, render } from "astro:content";
import Crumb from "../../components/crumb.astro";
import PageTitle from "../../components/page-title.astro";
import PageLayout from "../../layouts/page.astro";

export async function getStaticPaths() {
  const thoughts = await getCollection("thoughts");
  return thoughts.map((thought) => ({
    params: { id: thought.id },
    props: { thought },
  }));
}

const { thought } = Astro.props;
const { Content } = await render(thought);
---

<PageLayout title={`Thoughts - ${thought.data.title}`}>
  <Crumb>Thoughts:</Crumb>
  <PageTitle>{thought.data.title}</PageTitle>

  <Content />
</PageLayout>
