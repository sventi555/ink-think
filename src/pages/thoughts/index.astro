---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/page.astro";
import PageTitle from "../../components/page-title.astro";

const allThoughts = await getCollection("thoughts");
---

<PageLayout title="Thoughts">
  <PageTitle>Thoughts</PageTitle>

  <ul class="ml-4 flex list-outside list-[circle] flex-col gap-1">
    {allThoughts.map((thought) => (
      <li>
        <a
          href={`/thoughts/${thought.id}`}
          class="block w-full border-b border-dashed border-neutral-400"
        >
          {thought.data.title}
        </a>
      </li>
    ))}
  </ul>
</PageLayout>
